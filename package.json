{
  "name": "xiaomimi-matcha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx backend/src/server.ts",
    "dev:all": "tsx backend/src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "esbuild backend/src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "cd frontend && npm run preview"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "framer-motion": "^11.11.17",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "vite": "^5.4.10"
  }
}
