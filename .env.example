# Gemini API Key (Required for RAG embeddings and LLM generation)
AI_API_KEY=

# Server Port (Default: 3000)
PORT=3000

# Client API Base URL (Optional, default is empty string which uses same-origin proxy)
VITE_API_BASE_URL=

# Qdrant Vector Database (Optional - can use Qdrant Cloud or local instance)
QDRANT_URL=
QDRANT_API_KEY=
