# Bariska Cloud API Key (dari https://kuota.bariska.cloud)
Bariska_Cloud_API=

# Bariska Cloud Base URL (default: https://api.bariska.cloud/v1)
BARISKA_BASE_URL=https://api.bariska.cloud/v1

# Bariska Model Name (default: gpt-4o-mini)
BARISKA_MODEL=gpt-4o-mini

# Server Port (Default: 3000)
PORT=3000

# Client API Base URL (Optional, default is empty string which uses same-origin proxy)
VITE_API_BASE_URL=
